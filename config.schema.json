{
  "pluginAlias": "PrometheusSensorPlugin2",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Display Prometheus metrics as HomeKit sensors.",
  "schema": {
    "type": "object",
    "required": ["name", "url"],
    "properties": {
      "name": {
        "title": "Accessory name",
        "type": "string",
        "placeholder": "Prometheus sensors"
      },
      "url": {
        "title": "Prometheus or Mimir base URL",
        "type": "string",
        "placeholder": "https://prometheus.example.com"
      },
      "username": {
        "title": "Basic authentication username",
        "type": "string"
      },
      "password": {
        "title": "Basic authentication password",
        "type": "string",
        "format": "password"
      },
      "bearerToken": {
        "title": "Bearer token",
        "type": "string",
        "format": "password"
      },
      "mimirTenantId": {
        "title": "Mimir tenant ID",
        "type": "string",
        "description": "Optional X-Scope-OrgID header for multi-tenant Mimir."
      }
    }
  }
}
